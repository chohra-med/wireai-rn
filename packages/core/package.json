{
  "name": "wireai-rn",
  "version": "0.2.3",
  "description": "Wire your AI agent to native mobile UI. Open-source React Native SDK for generative UI — render interactive native components from LLM responses.",
  "keywords": [
    "react-native",
    "expo",
    "ai",
    "llm",
    "generative-ui",
    "mobile",
    "wireai",
    "agent",
    "zod",
    "ollama"
  ],
  "author": "Malik Chohra <malik@getwireai.com>",
  "license": "MIT",
  "homepage": "https://getwireai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/chohra-med/wireai-rn.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/chohra-med/wireai-rn/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./components": {
      "react-native": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/components/index.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "zod": ">=3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "zod": "^3.23.0"
  }
}
