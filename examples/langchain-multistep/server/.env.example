# Required — OpenAI key used by both LangChain steps.
OPENAI_API_KEY=sk-...

# Optional — override the model used by the chain (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional — Express port (default: 3000).
PORT=3000

# Optional — LangSmith tracing. Uncomment to trace every chain run.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_PROJECT=wire-rn-langchain-multistep
